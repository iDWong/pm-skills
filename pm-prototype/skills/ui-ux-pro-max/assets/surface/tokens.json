{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "ui-ux-pro-max-surface",
  "version": "1.1.0",
  "description": "KiraKira 三端设计系统令牌。glass.* 引用宿主的 surface.*；运营后台将其映射为 SemiDesign 实心面。",
  "source": "KiraKira 移动端、官网与运营管理系统实测提取",

  "glass": {
    "bg":        { "dark": "rgba(30,30,30,.55)",   "light": "rgba(252,251,247,.50)", "flat": "{surface.base}" },
    "blur":      { "dark": "blur(22px) saturate(1.35)", "light": "blur(20px) saturate(1.6) brightness(1.02)", "flat": "none" },
    "border":    { "dark": "rgba(255,255,255,.09)", "light": "rgba(43,42,38,.09)",   "flat": "{surface.borderSubtle}" },
    "highlight": { "dark": "inset 0 1px 0 rgba(255,255,255,.05)", "light": "inset 0 1px 0 rgba(255,255,255,.85)", "flat": "inset 0 0 0 0 transparent" },
    "ctl":       { "dark": "rgba(255,255,255,.055)", "light": "rgba(255,255,255,.46)", "flat": "{surface.soft}" },
    "ctlBorder": { "dark": "rgba(255,255,255,.12)",  "light": "rgba(43,42,38,.11)",    "flat": "{surface.border}" },
    "blurSm":    { "dark": "blur(10px) saturate(1.2)", "light": "blur(9px) saturate(1.4) brightness(1.02)", "flat": "none" },
    "_note": "浅色多一个 brightness(1.02)：浅底只加 saturate 会发闷。浅色 highlight 需接近纯白(.85)才可见，深色只要 .05。"
  },

  "ambient": {
    "texture": {
      "dark":  "repeating-linear-gradient(45deg,rgba(255,255,255,.035) 0 1.5px,transparent 1.5px 7px)",
      "light": "repeating-linear-gradient(45deg,rgba(43,42,38,.05) 0 1.5px,transparent 1.5px 7px)",
      "flat":  "none"
    },
    "_note": "磨砂可见性完全依赖这一层。模糊纯色或平滑渐变的结果不变 —— 必须是高频细节。大色斑光晕对磨砂零贡献。"
  },

  "material": {
    "nav":  { "dark": "rgba(10,10,10,.86)", "light": "rgba(243,242,238,.88)", "flat": "{surface.bg}" },
    "dock": { "dark": "rgba(26,26,26,.95)", "light": "rgba(251,250,246,.95)", "flat": "{surface.base}" },
    "_note": "降级时必须转实心：没有模糊的半透明只会让滚动内容在栏后拖出脏影。"
  },

  "shadow": {
    "card": {
      "dark":  "0 20px 25px -5px rgb(0 0 0/.35), 0 8px 10px -6px rgb(0 0 0/.30)",
      "light": "0 10px 28px rgba(43,42,38,.08), 0 2px 6px rgba(43,42,38,.05)"
    },
    "_note": "不属于玻璃。降级时保留，靠它维持卡片边界 —— 一起关掉会让降级态糊成一片。"
  },

  "surface": {
    "bg":           { "dark": "#0A0A0A", "light": "#F3F2EE" },
    "base":         { "dark": "#1A1A1A", "light": "#FBFAF6" },
    "soft":         { "dark": "#121212", "light": "#F2EEE8" },
    "border":       { "dark": "rgba(255,255,255,.10)", "light": "#D8D7D3" },
    "borderSubtle": { "dark": "rgba(255,255,255,.05)", "light": "#D5D5CB" }
  },

  "text": {
    "tertiary": { "dark": "#8E97A3", "light": "#67665C" },
    "inactive": { "dark": "#838C99", "light": "#67665C" },
    "_note": "实测反推值，非设计偏好。浅色三阶在纯色底可用 #6E6D63(4.65:1)；加斜纹后最暗处掉到 4.25:1，故压到 #67665C(4.60:1)。不用纹理可退回 #6E6D63。"
  },

  "layering": {
    "panel":   { "blur": "{glass.blur}",    "bg": "{glass.bg}",  "border": "{glass.border}",
                 "members": ["card", "post", "list-group", "table-wrap", "kpi", "sheet", "dropdown", "toast"] },
    "control": { "blur": "{glass.blurSm}",  "bg": "{glass.ctl}", "border": "{glass.ctlBorder}",
                 "members": ["chip", "input", "textarea", "select", "stat", "button-secondary", "button-outline", "button-ghost", "bubble-incoming"] },
    "solid":   { "blur": "none",
                 "members": ["button-primary", "button-danger", "badge", "chip-selected", "bubble-outgoing"],
                 "_note": "承载 on-brand 文字的实心色块，透明化会击穿对比度保证。" },
    "_note": "两层而非一刀切：实测每页模糊元素 24–63 个，大半径只占 9–14 个。"
  },

  "degradation": {
    "entries": [
      "data-glass=\"off\"",
      "@media (prefers-reduced-transparency: reduce)",
      "@supports not (backdrop-filter)"
    ],
    "deviceTier": "pointer:coarse 且 (deviceMemory<=4 或 hardwareConcurrency<=4)。桌面不降级。",
    "_warn": "选择器必须带 > body：主题类常同时打在 html 和 body 上，body 会把玻璃令牌重新声明一遍，只作用于 :root 的降级会静默失效。"
  },

  "brand": {
    "appWeb": { "dark": "#D9FF00", "light": "#2B2A26", "onDark": "#000000", "onLight": "#FBFAF6" },
    "admin": { "base": "#0064FA", "strong": "#0062D6", "press": "#004FB3", "onBrand": "#FFFFFF" },
    "_note": "App/官网使用酸绿或浅色墨色强调；运营后台使用 SemiDesign 蓝色，两个体系不可混用。"
  },

  "shape": {
    "appWeb": { "radiusSm": "6px", "radiusControl": "16px", "radiusCard": "18px", "radiusSheet": "24px", "targetMin": "44px" },
    "admin": { "radiusSm": "3px", "radiusControl": "6px", "radiusCard": "12px", "targetDefault": "32px", "targetCompact": "28px", "targetLarge": "40px" }
  },

  "layout": {
    "app": { "gutter": "16px" },
    "web": { "wrap": "1200px", "wrapNarrow": "920px", "navHeight": "68px", "gutterDesktop": "32px", "gutterMobile": "20px", "breakpoints": ["980px", "680px"] },
    "admin": { "sidebar": "232px", "cardPadding": "20px", "tableCell": "11px 12px", "collapse": "900px" }
  },

  "zIndex": { "base": 0, "sticky": 10, "chrome": 16, "fab": 18, "scrim": 39, "sheet": 40, "toast": 60, "dev": 80 },

  "verified": {
    "scope": "KiraKira 移动端、官网与运营管理系统 × 双主题 / 扁平后台",
    "wcagAA": "0 项不达标",
    "minMargin": { "glass": "4.5 + 0.11", "degraded": "4.5 + 0.50" }
  }
}
